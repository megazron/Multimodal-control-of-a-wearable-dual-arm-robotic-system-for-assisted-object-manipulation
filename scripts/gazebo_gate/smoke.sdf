<?xml version="1.0"?>
<sdf version="1.9">
  <world name="smoke">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <gravity>0 0 -9.81</gravity>
    <model name="ground">
      <static>true</static>
      <link name="l"><collision name="c"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry></collision></link>
    </model>
    <model name="cube">
      <pose>0 0 0.5 0 0 0</pose>
      <link name="l">
        <inertial><mass>0.05</mass><inertia><ixx>1.3e-5</ixx><iyy>1.3e-5</iyy><izz>1.3e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><geometry><box><size>0.04 0.04 0.04</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.04 0.04 0.04</size></box></geometry></visual>
      </link>
    </model>
  </world>
</sdf>
