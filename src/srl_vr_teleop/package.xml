<?xml version="1.0"?>
<package format="3">
  <name>srl_vr_teleop</name>
  <version>0.1.0</version>
  <description>Meta Quest teleoperation for the SRL rig. A SEPARATE input
  modality from the mannequin master: full 6-DOF including yaw. Depends on
  srl_perception and srl_moveit_config; NEVER on srl_teleop.</description>
  <maintainer email="gmsayyadsvc4@gmail.com">gausms</maintainer>
  <license>Apache-2.0</license>
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>trajectory_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>srl_perception</depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
