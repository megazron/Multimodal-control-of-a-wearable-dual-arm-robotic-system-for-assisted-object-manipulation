Panels: []
Visualization Manager:
  Fixed Frame: master_base
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.05
      Plane Cell Count: 12
      Color: 90; 90; 90
      Alpha: 0.35
      Reference Frame: master_base
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 0.05
      Show Axes: true
      Show Names: true
      Value: true
  Tools: []
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 0.62
      Focal Point: {X: 0, Y: 0, Z: 0.16}
      Pitch: 0.22
      Yaw: 0.9
      Name: Current View
Window Geometry:
  Height: 1000
  Width: 1600
  X: 0
  Y: 0
  Displays:
    collapsed: true
  Hide Left Dock: true
  Hide Right Dock: true
