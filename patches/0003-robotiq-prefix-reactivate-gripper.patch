+  // PREFIXED. The GPIO name was a literal here, so on a dual-arm robot both
+  // gripper components exported the identical resource "reactivate_gripper"
+  // and the second to load exported none of its command interfaces -- the
+  // knuckle showing [unavailable] [unclaimed] while the other arm's was
+  // [available] [claimed]. Prefixing the GPIO in the xacro alone was NOT
+  // enough: that fixed the URDF declaration while this code still exported
+  // the unprefixed name, so the two disagreed. It went unnoticed because
+  // robotiq_driver is COLCON_IGNOREd here (it needs a `serial` package that
+  // is unavailable) and every gripper test to date ran against
+  // mock_components/GenericSystem, which reads the URDF and never runs this.
+  const std::string prefix = info_.hardware_parameters.count("prefix")
+                                 ? info_.hardware_parameters.at("prefix")
+                                 : std::string("");
   command_interfaces.emplace_back(hardware_interface::CommandInterface(
-      "reactivate_gripper", "reactivate_gripper_response", &reactivate_gripper_response_));
+      prefix + "reactivate_gripper", "reactivate_gripper_cmd", &reactivate_gripper_cmd_));
+  command_interfaces.emplace_back(hardware_interface::CommandInterface(
+      prefix + "reactivate_gripper", "reactivate_gripper_response", &reactivate_gripper_response_));
 
   return command_interfaces;
