<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="srl_dual">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import srl_dual urdf file -->
    <xacro:include filename="$(find srl_description)/urdf/srl_dual.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="srl_dual.ros2_control.xacro" />


    <xacro:srl_dual_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
