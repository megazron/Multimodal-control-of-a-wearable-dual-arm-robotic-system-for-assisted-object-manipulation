+  // RESOURCE PREFIX. Empty for a single arm, so single-arm behaviour is
+  // bit-identical to upstream. On a DUAL-arm robot the non-joint resources
+  // ("tcp", "reset_fault") are otherwise identical between the two hardware
+  // components, and ros2_control resource names must be unique across the
+  // whole robot -- the second component to load loses, exactly as the
+  // unprefixed reactivate_gripper GPIO did.
+  resource_prefix_ = info_.hardware_parameters.count("prefix")
+                       ? info_.hardware_parameters["prefix"]
+                       : std::string("");
+  // The vendor xacro writes tf_prefix wrapped in literal quotes; tolerate the
+  // same accident here rather than exporting a resource called "left_".
+  resource_prefix_.erase(
+    std::remove(resource_prefix_.begin(), resource_prefix_.end(), '"'),
+    resource_prefix_.end());
+  RCLCPP_INFO(LOGGER, "Resource prefix is '%s'", resource_prefix_.c_str());
