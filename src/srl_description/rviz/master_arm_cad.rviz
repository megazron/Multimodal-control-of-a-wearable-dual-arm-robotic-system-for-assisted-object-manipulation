# RViz config for the CAD master arm.
#
# DERIVED FROM verification_capture.rviz RATHER THAN HAND-WRITTEN, and that is
# the whole point. The hand-written version put `Fixed Frame` directly under
# `Visualization Manager` instead of under `Global Options:`. RViz does not
# error on a key in the wrong place -- it SILENTLY USES THE DEFAULT -- so the
# fixed frame fell back to one that does not exist, links could not be
# transformed, and the panel rendered a single stub while TF was perfect and
# the meshes were fine. `Marker Scale: 0.05` was ignored for the same reason,
# which was the corroborating clue.
#
# Same failure class as the transient-local durability bug: a config that is
# accepted, ignored, and gives no diagnostic. Start from a config known to
# render and change only what must change.
Panels: []
Visualization Manager:
  Class: ""
  Name: root
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.05
      Plane Cell Count: 14
      Color: 90; 90; 90
      Alpha: 0.4
      Plane: XY
      Reference Frame: master_base
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Depth: 5
        # TRANSIENT LOCAL, NOT VOLATILE. robot_state_publisher latches
        # /robot_description: it publishes ONE message at startup and never
        # again. A Volatile subscriber that arrives afterwards never receives
        # it, so RViz renders an empty scene -- and it is ORDER DEPENDENT,
        # which is why it looked intermittent: RViz started before the stack
        # was already subscribed and worked, RViz started after showed
        # nothing. The MarkerArray display twenty lines below already asked
        # for Transient Local, so the hazard was known for /task_objects and
        # missed for the robot.
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
      TF Prefix: ""
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: TaskObjects
      Enabled: true
      Namespaces: {}
      Topic:
        Depth: 20
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /task_objects
      Value: true
  Global Options:
    Background Color: 45; 45; 48
    Fixed Frame: master_base
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: FixedFront
      Distance: 0.55
      Focal Point:
        X: 0
        Y: 0
        Z: 0.17
      Pitch: 0.30
      Yaw: 0.90
      Target Frame: master_base
      Near Clip Distance: 0.01
      Invert Z Axis: false
      Value: Orbit (rviz_default_plugins)
    Saved:
      - Class: rviz_default_plugins/Orbit
        Name: WearerPOV
        Distance: 0.55
        Focal Point:
          X: 0
          Y: 0
          Z: 0.17
        Pitch: 0.30
        Yaw: 0.90
        Target Frame: master_base
        Near Clip Distance: 0.01
        Value: Orbit (rviz_default_plugins)
Window Geometry:
  Height: 1000
  Width: 1600
  Hide Left Dock: true
  Hide Right Dock: true
