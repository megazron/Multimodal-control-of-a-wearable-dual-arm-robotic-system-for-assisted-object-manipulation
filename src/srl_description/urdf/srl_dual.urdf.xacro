<?xml version="1.0"?>
<robot name="srl_dual" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:arg name="use_fake_hardware" default="true"/>
  <!-- Grippers get their OWN flag. robotiq_driver is not built in this
       workspace (the plugin class is not registered), and a missing gripper
       plugin aborts the ENTIRE hardware load including the arms. Keeping the
       grippers mock lets the real ARMS come up on their own. -->
  <xacro:arg name="use_fake_gripper_hardware" default="true"/>
  <!-- PER-ARM hardware selection. kortex_driver exports the Cartesian
       command interfaces (tcp/twist.*, tcp/pose.*) WITHOUT an arm prefix, so
       two real Kortex components collide:
         "ResourceStorage: Tried to insert CommandInterface with already
          existing key. Insert[tcp/twist.linear.x]"
       and the collision aborts the whole hardware load. Until that is fixed
       upstream, only ONE arm may use the real driver at a time. -->
  <xacro:arg name="left_use_fake_hardware"  default="$(arg use_fake_hardware)"/>
  <xacro:arg name="right_use_fake_hardware" default="$(arg use_fake_hardware)"/>
  <xacro:arg name="left_robot_ip"  default="192.168.1.10"/>
  <xacro:arg name="right_robot_ip" default="192.168.1.9"/>
  <!-- Each real gripper needs its OWN serial port. The vendor macro defaults
       both to /dev/ttyUSB0, so with two real arms the two drivers would fight
       over one device: the same unprefixed-resource class of bug as the
       reactivate_gripper GPIO. -->
  <xacro:arg name="left_gripper_com_port"  default="/dev/ttyUSB0"/>
  <xacro:arg name="right_gripper_com_port" default="/dev/ttyUSB1"/>

  <!-- ARM MOUNT. Derived in closed form; see human_backpack.xacro and
       CLAUDE.md. Position is backpack-relative; the backpack link is at
       torso+(0,-0.12,0.02), so world = (mount_x, mount_y-0.12, mount_z+1.07).
       Exposed as arguments so a candidate can be swept without editing. -->
  <xacro:arg name="mount_x" default="0.35"/>
  <xacro:arg name="mount_y" default="-0.2"/>
  <xacro:arg name="mount_z" default="0.18"/>
  <xacro:arg name="left_mount_rpy"  default="1.247666407 -0.232161321 1.769864051"/>
  <xacro:arg name="right_mount_rpy" default="-1.256457931 -0.033197491 1.437832587"/>

  <link name="world"/>

  <xacro:include filename="$(find srl_description)/urdf/human_backpack.xacro"/>
  <xacro:human_backpack parent="world"
                        mount_x="$(arg mount_x)"
                        mount_y="$(arg mount_y)"
                        mount_z="$(arg mount_z)"
                        left_mount_rpy="$(arg left_mount_rpy)"
                        right_mount_rpy="$(arg right_mount_rpy)"/>

  <xacro:include filename="$(find kortex_description)/arms/gen3/7dof/urdf/gen3_macro.xacro"/>
  <!-- Robotiq 2F-85 gripper macro (from the robotiq_description package,
       included via kortex_description's own grippers/ path, matching
       exactly how kortex_robot.xacro's load_robot wires it in). -->
  <xacro:include filename="$(find kortex_description)/grippers/robotiq_2f_85/urdf/robotiq_2f_85_macro.xacro"/>

  <!-- LEFT arm.
       initial_positions == THE SOLVED PRESENTATION POSE (set 2026-08-16).
       Kortex 59.59/103.34/275.80/80.76/352.85/326.88/71.97.
       Mirrors config/home_positions_left.txt; KEEP THE TWO IN STEP.
       One updated without the other is a documented trap in this project.

       SOLVED, NOT CHOSEN. scripts/solve_home_pose.py states the pose as nine
       geometric constraints (forearm forward, elbow below the shoulder, wrist
       level, wrist FACING FORWARD, gripper camera on top, hands in front of
       the chest, wearer clearance, mirror symmetry) and searches the joint space for them. The
       achieved value of every one is in config/home_positions_left.txt and in
       recordings/baselines/home_solved.json.

       THE CONSTRAINT THAT WAS MISSING FOR THREE ATTEMPTS was the ROLL about
       the approach axis. "Wrists level" was measured as the tool AXIS
       elevation and was genuinely 0.00 deg, while the roll went unconstrained
       and put the wrist camera 56.4 mm BELOW the fingertips on both arms. A
       level axis says nothing about which way up the hand is.

       SIM AND REAL DISAGREE, DELIBERATELY AND TEMPORARILY. The real arm is
       still parked at the legacy Kortex home
       259.03/277.69/267.74/286.14/194.10/27.48/55.26, so enabling the sim to real bridge is NOT a no-op. It is not a
       jump either: sim_to_real_bridge.enable() checks the real arm against
       home_positions_left.txt and REFUSES, naming the joint and the size. The
       pose is captured on the hardware next lab session (see
       docs/NEXT_SESSION.md); until then the refusal is the design.

       This value is baked at LAUNCH, so a colcon build is required before the
       sim arms start here. Text files changed without a rebuild leave the
       arms at the old pose while everything else says otherwise. -->
  <xacro:load_arm
      parent="left_mount"
      prefix="left_"
      dof="7"
      vision="true"
      robot_ip="$(arg left_robot_ip)"
      use_fake_hardware="$(arg left_use_fake_hardware)"
      gripper="robotiq_2f_85"
      gripper_joint_name="left_robotiq_85_left_knuckle_joint"
      use_internal_bus_gripper_comm="true"
      initial_positions="${dict(joint_1=1.040042,joint_2=1.803623,joint_3=-1.469567,joint_4=1.409528,joint_5=-0.124791,joint_6=-0.578053,joint_7=1.256113)}">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:load_arm>

  <!-- LEFT gripper: attaches to left_end_effector_link, matching the
       parent="${prefix}${last_arm_link}" pattern kortex_robot.xacro uses -->
  <xacro:load_gripper
      parent="left_end_effector_link"
      prefix="left_"
      com_port="$(arg left_gripper_com_port)"
      use_fake_hardware="$(arg use_fake_gripper_hardware)"
      moveit_active="true"/>

  <!-- RIGHT arm.
       initial_positions == THE SOLVED PRESENTATION POSE, same solver run and
       same constraint set as the left.
       Kortex 309.20/108.48/91.24/82.52/212.63/36.52/233.54.
       Mirrors config/home_positions_right.txt; KEEP THE TWO IN STEP.

       Every continuous joint (1/3/5/7) is inside +/-pi as stored, so there is
       no hand wrapping to remember this time: the solver's search box for a
       continuous joint IS +/-pi, so a pose outside it cannot be returned.

       THE TWO ARMS CANNOT MIRROR EXACTLY. Reflecting the LEFT mount through
       x = 0 leaves it 168.00 deg of roll from the RIGHT mount, measured off
       this file. The whole-chain mirror residual is 0.0272 m, against 0.2826
       for the pose this replaces.

       The real arm is still at the legacy Kortex home
       303.65/77.06/98.57/58.57/317.14/36.39/154.71; the bridge refuses on the difference rather than commanding
       it. No reading has ever been taken from the right arm at all. -->
  <xacro:load_arm
      parent="right_mount"
      prefix="right_"
      dof="7"
      vision="true"
      robot_ip="$(arg right_robot_ip)"
      use_fake_hardware="$(arg right_use_fake_hardware)"
      gripper="robotiq_2f_85"
      gripper_joint_name="right_robotiq_85_left_knuckle_joint"
      use_internal_bus_gripper_comm="true"
      initial_positions="${dict(joint_1=-0.886627,joint_2=1.893333,joint_3=1.592438,joint_4=1.440246,joint_5=-2.572092,joint_6=0.637394,joint_7=-2.207143)}">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:load_arm>

  <!-- RIGHT gripper -->
  <xacro:load_gripper
      parent="right_end_effector_link"
      prefix="right_"
      com_port="$(arg right_gripper_com_port)"
      use_fake_hardware="$(arg use_fake_gripper_hardware)"
      moveit_active="true"/>

</robot>

